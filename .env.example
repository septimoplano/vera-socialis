# Copiar a .env y ajustar. NUNCA commitear .env (spec §8).

NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Postgres local de docker-compose. En producción: cadena de Neon.
# DB_PUERTO es el puerto del HOST (5433 evita chocar con otros Postgres locales).
DB_PUERTO=5433
DATABASE_URL=postgres://vera:vera_local@localhost:5433/vera_socialis

# Firma de cookies. En producción es obligatorio cambiarlo (mínimo 32 caracteres).
COOKIE_SECRET=desarrollo-local-cambiar-en-produccion-32+

# WebAuthn necesita un dominio estable con HTTPS. En producción se reemplaza por
# el dominio real; con estos valores en producción la API se niega a arrancar.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGEN=http://localhost:5173

# Se agregan cuando lleguen sus tareas:
# CLAUDE_API_KEY=        (B7 · clasificación de sentimiento y moderación)
# R2_ACCOUNT_ID=         (B4 · selfies y media)
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
